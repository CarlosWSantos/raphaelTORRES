{
    "manifest_version": 3,
    "name": "Substituto Raphael TORRES",
    "version": "1.0",
    "description": "Substitui 'Raphael Torres' por 'Raphael T O R R E S' nas paginas da web.",
    "icons": {
    "16": "torres16.png",
    "48": "torres48.png",
    "128": "torres.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}